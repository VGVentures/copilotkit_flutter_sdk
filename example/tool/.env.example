# Copy to example/tool/.env (git ignored) and fill in. Never commit real keys.

# Model provider key (see example/README.md for the other providers).
OPENAI_API_KEY=

# Optional. Setting this key switches the runtime to Intelligence mode, so
# threads are recorded and can feed Learning. Leave it empty for plain SSE.
CPK_INTELLIGENCE_API_KEY=

# Learning container that threads are assigned to (Intelligence mode only).
# 1-64 lowercase letters, numbers or single hyphens. Create the container
# with this id in the dashboard first. Defaults to flutter-example.
CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=flutter-example
